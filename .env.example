# 키움증권 REST API 인증 정보
# 키움 개발자 센터(https://openapi.kiwoom.com) 에서 발급받은 값을 채워 넣으세요.
# 초보자 팁: 실계좌 키는 절대 사용하지 말고, 처음엔 "모의투자" 키만 사용하세요.

# mock = 모의투자(가상 돈), real = 실거래(진짜 돈) — 반드시 mock으로 시작!
KIWOOM_MODE=mock

# 모의투자 AppKey / AppSecret
KIWOOM_APP_KEY=
KIWOOM_APP_SECRET=

# (선택) 계좌번호. 일부 주문 엔드포인트에서 필요. 모의투자는 개발자 센터에서 확인.
KIWOOM_ACCOUNT_NO=

# (선택) OAuth 토큰 디스크 캐시 경로 — 봇 재시작 시 토큰 재발급 회피 (24h TTL 활용).
# 활성: data/auth/token.json (data/ 는 .gitignore 자동 제외, 파일 권한 0o600).
# 비우면 메모리 only — 재시작 시마다 /oauth2/token 재호출 (au10001 rate limit 위험).
KIWOOM_TOKEN_CACHE_PATH=

# 로그 레벨: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# (선택) 텔레그램 알림 — paper 운영 중 체결·러너 정지 등을 모바일 푸시.
# 둘 중 하나라도 비어있으면 알림 비활성화 (Noop). 동작은 동일.
# 1) BotFather (@BotFather) 에게 /newbot → 토큰 발급
# 2) 본인 봇과 대화 시작 → https://api.telegram.org/bot<TOKEN>/getUpdates 에서 chat.id 확인
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# (선택) 텔레그램 인커밍 명령(/status /balance /positions /pnl /last_signal) 허용 chat_id 목록.
# 콤마 구분. 비우면 인커밍 명령 비활성 — 봇은 푸시만 한다(v1 동작).
# 보통 본인 chat_id 한 개 (위 TELEGRAM_CHAT_ID 와 동일) 만 넣어두면 충분.
TELEGRAM_ALLOWED_CHAT_IDS=

# (선택) Claude API — `auto-trade strategy advise` 가 프로파일 방향성을 조정.
# 비우면 advise 명령 비활성. 모델은 비용 절감을 위해 Sonnet 계열로 바꿔도 무방하다.
# 호출은 사람이 명령으로 트리거할 때만 발생 (자동 실행 X).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-7

# (선택) LLM 비용 누적 추적 + 월 한도 차단. 활성 시 모든 LLM 호출이 JSONL 에 누적되고,
# 월 한도(LLM_MONTHLY_BUDGET_USD, default $5) 초과 시 자동 차단 (LLMBudgetExceeded).
# 비우면 비활성 (기존 동작 호환). 운영 권장: data/llm-cost.jsonl.
LLM_COST_PATH=
LLM_MONTHLY_BUDGET_USD=5.0

# (선택) 신호→주문 latency 모니터링. 활성 시 runner 가 주문 송신 시간을 JSONL 에
# 누적. `auto-trade latency` 로 일별 p50/p95/p99 통계 확인. 실거래 가까울수록 유용.
# 비우면 비활성. 운영 권장: data/latency.jsonl.
LATENCY_LOG_PATH=

# (선택) 유니버스 종목 0B 틱 원본 기록 — 일별 파일(data/ticks/ticks-YYYY-MM-DD.jsonl).
# 활성 시 runner 가 수신하는 모든 체결 틱을 버퍼링 후 JSONL append (트레이딩 무영향).
# 용도: 틱 기반 손절 가드 반사실 분석 데이터 수집. 장중 3종목 기준 용량 수 MB 수준.
# 비우면 비활성. 운영 권장: data/ticks
TICK_LOG_DIR=
