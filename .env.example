# 키움증권 REST API 인증 정보
# 키움 개발자 센터(https://openapi.kiwoom.com) 에서 발급받은 값을 채워 넣으세요.
# 초보자 팁: 실계좌 키는 절대 사용하지 말고, 처음엔 "모의투자" 키만 사용하세요.

# mock = 모의투자(가상 돈), real = 실거래(진짜 돈) — 반드시 mock으로 시작!
KIWOOM_MODE=mock

# 모의투자 AppKey / AppSecret
KIWOOM_APP_KEY=
KIWOOM_APP_SECRET=

# (선택) 계좌번호. 일부 주문 엔드포인트에서 필요. 모의투자는 개발자 센터에서 확인.
KIWOOM_ACCOUNT_NO=

# 로그 레벨: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# (선택) 텔레그램 알림 — paper 운영 중 체결·러너 정지 등을 모바일 푸시.
# 둘 중 하나라도 비어있으면 알림 비활성화 (Noop). 동작은 동일.
# 1) BotFather (@BotFather) 에게 /newbot → 토큰 발급
# 2) 본인 봇과 대화 시작 → https://api.telegram.org/bot<TOKEN>/getUpdates 에서 chat.id 확인
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# (선택) 텔레그램 인커밍 명령(/status /balance /positions /pnl /last_signal) 허용 chat_id 목록.
# 콤마 구분. 비우면 인커밍 명령 비활성 — 봇은 푸시만 한다(v1 동작).
# 보통 본인 chat_id 한 개 (위 TELEGRAM_CHAT_ID 와 동일) 만 넣어두면 충분.
TELEGRAM_ALLOWED_CHAT_IDS=
