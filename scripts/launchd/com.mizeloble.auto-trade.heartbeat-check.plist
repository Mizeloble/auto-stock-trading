<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.mizeloble.auto-trade.heartbeat-check</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/jjmize/Project/auto-stock-trading/scripts/heartbeat-check.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/jjmize/Project/auto-stock-trading</string>

    <!-- 5분(300초) 간격. 평일 장중 게이트는 셸 스크립트가 처리 (plist 단순화). -->
    <key>StartInterval</key>
    <integer>300</integer>

    <!-- 등록 직후 1회 즉시 실행 X — 다음 5분 경계부터 동작. -->
    <key>RunAtLoad</key>
    <false/>

    <key>KeepAlive</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/jjmize/Project/auto-stock-trading/logs/launchd-heartbeat-check.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/jjmize/Project/auto-stock-trading/logs/launchd-heartbeat-check.err.log</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
