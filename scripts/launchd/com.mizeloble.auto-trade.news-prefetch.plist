<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.mizeloble.auto-trade.news-prefetch</string>

    <key>ProgramArguments</key>
    <array>
        <string>__PROJECT_DIR__/scripts/news-prefetch.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__PROJECT_DIR__</string>

    <!-- 매주 토요일 06:00 KST. 27단계 — 09:00 weekly-proposal 의 RSS 캐시 선반영.
         launchd Weekday 표기는 6=토요일 (Apple `man launchd.plist`).
         LLM 호출 없음 → 비용 0. fetch 실패해도 09:00 호출이 force_refresh 로 회복. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key><integer>6</integer>
        <key>Hour</key><integer>6</integer>
        <key>Minute</key><integer>0</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>KeepAlive</key>
    <false/>

    <key>StandardOutPath</key>
    <string>__PROJECT_DIR__/logs/launchd-news-prefetch.out.log</string>
    <key>StandardErrorPath</key>
    <string>__PROJECT_DIR__/logs/launchd-news-prefetch.err.log</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
